size = Vector2(112, 320)

[node name="Hint4" parent="Hints" unique_id=638285919 instance=ExtResource("10_ar2b2")]
position = Vector2(392, 160)
text = "Przepaść! Rozpędź się i przeskocz."
size = Vector2(80, 320)

[node name="Hint5" parent="Hints" unique_id=608900747 instance=ExtResource("10_ar2b2")]
position = Vector2(472, 160)
text = "Zbieraj pieniążki!
